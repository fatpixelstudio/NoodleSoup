{
  "name": "noodlesoup",
  "version": "0.1.14",
  "description": "NoodleSoup front-end starter kit",
  "repository": "https://github.com/fatpixelstudio/NoodleSoup",
  "author": "Fat Pixel Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "yarn version --patch && webpack --config=webpack.prod.js",
    "start": "run-p webpack:watch svg:watch",
    "webpack:watch": "webpack --config=webpack.dev.js --watch",
    "svg": "svgo -f design/assets/svg -o assets/images/svg",
    "svg:watch": "yarn svg; chokidar 'design/assets/svg/**/*.svg' -c 'yarn svg'",
    "deploy": "./bin/deploy.sh"
  },
  "devDependencies": {
    "autoprefixer": "^10.0.0",
    "chokidar-cli": "^3.0.0",
    "css-loader": "^7.0.0",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "mini-css-extract-plugin": "^2.2.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.23",
    "postcss-loader": "^8.0.0",
    "sass": "^1.45.1",
    "sass-loader": "^17.0.0",
    "svgo": "3.3.4",
    "terser-webpack-plugin": "^5.2.4",
    "webpack": "^5.52.0",
    "webpack-cli": "^7.0.0",
    "webpack-merge": "^6.0.0",
    "webpack-notifier": "^1.15.0"
  },
  "dependencies": {
    "domready": "^1.0.8",
    "fontfaceobserver": "^2.1.0"
  },
  "resolutions": {
    "node-notifier": "^10.0.1"
  }
}
